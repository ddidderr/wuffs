// -------- log2.
//
// This is a bit-exact port of glibc 2.39's x86-64 "__log2_fma" function
// (sysdeps/ieee754/dbl-64/e_log2.c compiled with -mfma -mavx2), which is what
// glibc's log2 resolves to at run time on x86-64 CPUs with FMA and AVX2. The
// sequence of f64 operations (including where the compiler contracted a
// multiply and add into a single fused multiply-add) was transcribed from the
// machine code of the shipped libm.so.6, and the constants were copied from
// its __log2_data table. Since every softfloat operation is correctly
// rounded, the result matches glibc bit-for-bit for every input.
//
// The algorithm is by Szabolcs Nagy (ARM's optimized-routines, MIT licensed).
// Its maximum error is about 0.55 ULP: it is not always correctly rounded,
// which is why this port reproduces glibc's exact operation sequence instead
// of computing a correctly rounded logarithm.

// LOG2_INVLN2_HI and LOG2_INVLN2_LO sum to approximately (1 / ln(2)).
pri const LOG2_INVLN2_HI : base.u64 = 0x3FF7_1547_6520_0000  // 0x1.7154765200000p+0
pri const LOG2_INVLN2_LO : base.u64 = 0x3DE7_05FC_2EEF_A200  // 0x1.705fc2eefa200p-33

// LOG2_A0 ..= LOG2_A5 are the "poly" coefficients (used when x is not near 1).
pri const LOG2_A0 : base.u64 = 0xBFE7_1547_652B_8339  // -0x1.71547652b8339p-1
pri const LOG2_A1 : base.u64 = 0x3FDE_C709_DC3A_04BE  // 0x1.ec709dc3a04bep-2
pri const LOG2_A2 : base.u64 = 0xBFD7_1547_6470_2FFB  // -0x1.7154764702ffbp-2
pri const LOG2_A3 : base.u64 = 0x3FD2_776C_5003_4C48  // 0x1.2776c50034c48p-2
pri const LOG2_A4 : base.u64 = 0xBFCE_C7B3_28EA_92BC  // -0x1.ec7b328ea92bcp-3
pri const LOG2_A5 : base.u64 = 0x3FCA_6225_E117_F92E  // 0x1.a6225e117f92ep-3

// LOG2_B0 ..= LOG2_B9 are the "poly1" coefficients (used when x is near 1).
pri const LOG2_B0 : base.u64 = 0xBFE7_1547_652B_82FE  // -0x1.71547652b82fep-1
pri const LOG2_B1 : base.u64 = 0x3FDE_C709_DC3A_03F7  // 0x1.ec709dc3a03f7p-2
pri const LOG2_B2 : base.u64 = 0xBFD7_1547_652B_7C3F  // -0x1.71547652b7c3fp-2
pri const LOG2_B3 : base.u64 = 0x3FD2_776C_50F0_5BE4  // 0x1.2776c50f05be4p-2
pri const LOG2_B4 : base.u64 = 0xBFCE_C709_DD76_8FE5  // -0x1.ec709dd768fe5p-3
pri const LOG2_B5 : base.u64 = 0x3FCA_6176_1EC4_E736  // 0x1.a61761ec4e736p-3
pri const LOG2_B6 : base.u64 = 0xBFC7_153F_BC64_A79B  // -0x1.7153fbc64a79bp-3
pri const LOG2_B7 : base.u64 = 0x3FC4_84D1_54F0_1B4A  // 0x1.484d154f01b4ap-3
pri const LOG2_B8 : base.u64 = 0xBFC2_89E4_A72C_383C  // -0x1.289e4a72c383cp-3
pri const LOG2_B9 : base.u64 = 0x3FC0_B32F_285A_EE66  // 0x1.0b32f285aee66p-3

pri const F64_ONE     : base.u64 = 0x3FF0_0000_0000_0000
pri const F64_NEG_ONE : base.u64 = 0xBFF0_0000_0000_0000

// log2_u64 returns the f64 bits of glibc's log2((double)v), where (double)v
// is C's (rounding) conversion. In particular, it returns -inf for v == 0.
pub func arith.log2_u64(v: base.u64) base.u64 {
    return this.log2_f64(x: this.f64_from_u64(a: args.v))
}

// log2_f64 returns the f64 bits of glibc's log2(x), for any f64 x, including
// special cases: log2(±0) is -inf, log2(+inf) is +inf, log2(1) is +0 and
// log2 of a NaN or of a negative number is a NaN.
pub func arith.log2_f64(x: base.u64) base.u64 {
    var ix   : base.u64
    var top  : base.u64
    var tmp  : base.u64
    var i    : base.u64
    var k    : base.u64
    var kd   : base.u64
    var invc : base.u64
    var logc : base.u64
    var z    : base.u64
    var r    : base.u64
    var r2   : base.u64
    var r4   : base.u64
    var t1   : base.u64
    var t2   : base.u64
    var t3   : base.u64
    var hi   : base.u64
    var lo   : base.u64
    var p    : base.u64
    var y    : base.u64

    ix = args.x

    // (ix - LO) < (HI - LO), where LO and HI are the bits of
    // (1.0 - 0x1.5b51p-5) and (1.0 + 0x1.6ab2p-5).
    if (ix ~mod- 0x3FEE_A4AF_0000_0000) < (0x3FF0_B559_0000_0000 - 0x3FEE_A4AF_0000_0000) {
        if ix == F64_ONE {
            return 0
        }
        r = this.f64_sub(a: ix, b: F64_ONE)
        hi = this.f64_mul(a: LOG2_INVLN2_HI, b: r)
        r2 = this.f64_mul(a: r, b: r)
        lo = this.f64_fma(a: LOG2_INVLN2_HI, b: r, c: this.f64_neg(a: hi))
        r4 = this.f64_mul(a: r2, b: r2)
        p = this.f64_fma(a: r, b: LOG2_B1, c: LOG2_B0)
        lo = this.f64_fma(a: r, b: LOG2_INVLN2_LO, c: lo)
        y = this.f64_fma(a: p, b: r2, c: hi)
        lo = this.f64_add(a: lo, b: this.f64_fma(a: p, b: r2, c: this.f64_sub(a: hi, b: y)))
        t1 = this.f64_fma(
                a: this.f64_fma(a: r, b: LOG2_B5, c: LOG2_B4),
                b: r2,
                c: this.f64_fma(a: r, b: LOG2_B3, c: LOG2_B2))
        t2 = this.f64_fma(
                a: this.f64_fma(a: r, b: LOG2_B9, c: LOG2_B8),
                b: r2,
                c: this.f64_fma(a: r, b: LOG2_B7, c: LOG2_B6))
        t3 = this.f64_fma(a: this.f64_fma(a: t2, b: r4, c: t1), b: r4, c: lo)
        return this.f64_add(a: y, b: t3)
    }

    top = ix >> 48
    if (top ~mod- 0x0010) >= (0x7FF0 - 0x0010) {
        // x < 0x1p-1022 or inf or nan.
        if (ix & F64_ABS) == 0 {
            // log2(±0) is -inf (and raises divide-by-zero).
            return 0xFFF0_0000_0000_0000
        } else if ix == F64_INF {
            return ix
        } else if ((top & 0x8000) <> 0) or ((top & 0x7FF0) == 0x7FF0) {
            // log2 of a negative number or NaN is invalid.
            if (ix & F64_ABS) > F64_INF {
                return ix | F64_QUIET
            }
            return F64_DEFAULT_NAN
        }
        // x is subnormal. Normalize it.
        ix = this.f64_mul(a: ix, b: 0x4330_0000_0000_0000) ~mod- (52 << 52)
    }

    // x = 2**k * z, where z is in the range [OFF, 2 * OFF) and exact. The
    // range is split into 64 subintervals. The i'th subinterval contains z
    // and c is near its center.
    tmp = ix ~mod- 0x3FE6_0000_0000_0000
    i = (tmp >> 46) & 63
    k = tmp >> 52
    if k >= 0x800 {
        // k is negative (as a 12-bit two's complement integer).
        kd = this.f64_neg(a: this.f64_from_u64(a: 0x1000 - k))
    } else {
        kd = this.f64_from_u64(a: k)
    }
    z = ix ~mod- (tmp & 0xFFF0_0000_0000_0000)
    invc = LOG2_TAB_INVC[i]
    logc = LOG2_TAB_LOGC[i]

    // log2(x) = log2(z/c) + log2(c) + k.
    // r ~= z/c - 1, |r| < 1/(2*N).
    t3 = this.f64_add(a: kd, b: logc)
    r = this.f64_fma(a: z, b: invc, c: F64_NEG_ONE)
    t1 = this.f64_mul(a: LOG2_INVLN2_HI, b: r)
    t2 = this.f64_fma(a: r, b: LOG2_INVLN2_LO,
            c: this.f64_fma(a: LOG2_INVLN2_HI, b: r, c: this.f64_neg(a: t1)))

    // hi + lo = r/ln2 + log2(c) + k.
    hi = this.f64_add(a: t1, b: t3)
    lo = this.f64_add(a: this.f64_add(a: this.f64_sub(a: t3, b: hi), b: t1), b: t2)

    // log2(r+1) = r/ln2 + r^2*poly(r).
    r2 = this.f64_mul(a: r, b: r)
    r4 = this.f64_mul(a: r2, b: r2)
    p = this.f64_fma(
            a: this.f64_fma(a: r, b: LOG2_A3, c: LOG2_A2),
            b: r2,
            c: this.f64_fma(a: r, b: LOG2_A1, c: LOG2_A0))
    p = this.f64_fma(a: this.f64_fma(a: r, b: LOG2_A5, c: LOG2_A4), b: r4, c: p)
    y = this.f64_fma(a: r2, b: p, c: lo)
    return this.f64_add(a: y, b: hi)
}

// LOG2_TAB_INVC[i] and LOG2_TAB_LOGC[i] are glibc's __log2_data.tab[i].invc
// and .logc: c is near the center of the i'th subinterval, invc is (1 / c)
// and logc is log2(c).

pri const LOG2_TAB_INVC : roarray[64] base.u64 = [
        0x3FF7_2428_6BB1_ACF8, 0x3FF6_E1F7_66D2_CCA1, 0x3FF6_A13D_0E30_D48A, 0x3FF6_61EC_32D0_6C85,
        0x3FF6_23FA_9511_98F8, 0x3FF5_E75B_A4CF_026C, 0x3FF5_AC05_5A21_4FB8, 0x3FF5_71ED_0F16_6E1E,
        0x3FF5_3909_590B_F835, 0x3FF5_014F_ED61_ADDD, 0x3FF4_CAB8_8E48_7BD0, 0x3FF4_9539_B433_4FEE,
        0x3FF4_60CB_DFAF_D569, 0x3FF4_2D66_4EE4_B953, 0x3FF3_FB01_111D_D8A6, 0x3FF3_C995_B70C_5836,
        0x3FF3_991C_4AB6_FD4A, 0x3FF3_698E_0CE0_99B5, 0x3FF3_3AE4_8213_E7B2, 0x3FF3_0D19_1985_BDB1,
        0x3FF2_E025_CAB2_71D7, 0x3FF2_B404_CF13_CD82, 0x3FF2_88B0_2C7C_CB50, 0x3FF2_5E22_6394_4DE5,
        0x3FF2_3456_3D86_15B1, 0x3FF2_0B46_E33E_AF38, 0x3FF1_E2EE_FDCD_A3DD, 0x3FF1_BB4A_580B_3930,
        0x3FF1_9453_847F_2200, 0x3FF1_6E06_C0D5_D73C, 0x3FF1_485F_47B7_E4C2, 0x3FF1_2358_AD00_85D1,
        0x3FF0_FEF0_0F53_2227, 0x3FF0_DB20_77D0_3A8F, 0x3FF0_B7E6_D659_80D9, 0x3FF0_953E_FE7B_408D,
        0x3FF0_7325_CAC5_3B83, 0x3FF0_5197_E40D_1B5C, 0x3FF0_3091_C120_8EA2, 0x3FF0_1010_25B3_7E21,
        0x3FEF_C07E_F9CA_A76B, 0x3FEF_4465_D3F6_F184, 0x3FEE_CC07_9F84_107F, 0x3FEE_573A_9997_5AE8,
